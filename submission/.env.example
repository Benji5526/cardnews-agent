# 이 파일을 .env로 복사해 필요한 값만 채우세요. 키 값은 채팅·문서·제출물에 붙여넣지 마세요.

# 서버 포트
PORT=4310

# --- 이미지 작업자 ---
# agy | gemini | auto (auto: agy가 설치돼 있고 AGY_ALLOW_ALL_TOOLS=1이면 agy, 아니면 gemini)
# IMAGE_WORKER=auto

# agy(Antigravity CLI)는 헤드리스에서 도구 권한을 받을 수 없어, 실행의 모든 도구 요청을 자동 승인해야 파일이 만들어진다.
# 요청마다 빈 작업 폴더에서만 실행되지만 완전한 격리는 아니다. DECISIONS.md의 권한 절을 읽고 동의할 때만 1로 켠다.
# AGY_ALLOW_ALL_TOOLS=1
# AGY_BIN=D:\Tools\agy\bin\agy.exe

# Gemini 이미지 (https://aistudio.google.com/apikey). 무료 등급은 이미지 모델 한도가 0일 수 있다.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- 조사 엔진 (Claude Code CLI) ---
# CLAUDE_BIN=claude
# CLAUDE_MODEL=sonnet
